# Copy to backend/.env — it is loaded automatically by `npm run dev` and `npm start`.
# Restart the backend after changing it.

# PORT=4000

# MongoDB connection string (e.g. MongoDB Atlas). Required: enquiries are stored in the
# "enquiries" collection of MONGODB_DB.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
# MONGODB_DB=bhsk

# Admin dashboard (/admin) sign-in. The dashboard is disabled until both are set.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Signs admin sessions (12 h). Use a long random string, e.g. `openssl rand -hex 32`;
# changing it signs everyone out.
# ADMIN_SESSION_SECRET=

# Comma-separated origins allowed to call the API from another domain
# (only needed when the frontend is hosted separately), or "*" for any.
# CORS_ORIGINS=https://bhsk.example.com,http://localhost:3000

# Forward every enquiry as JSON POST
# ENQUIRY_WEBHOOK_URL=

# Email via Resend (https://resend.com)
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=Info@bhsknursingservices.com
# ENQUIRY_FROM_EMAIL=onboarding@resend.dev

# Override the location of the built frontend served by `npm start` (defaults to frontend/dist).
# FRONTEND_DIST=
