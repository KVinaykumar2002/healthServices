# The backend URL lives in shared/urls.ts (BACKEND_URL) — production builds call it automatically,
# and local dev proxies /api to the backend on localhost:4000.
# Only set this to override that, without a trailing slash. An empty value means "same origin"
# (use it when the backend serves this build via `npm start`).
# VITE_API_BASE_URL=https://healthservicesbackend.onrender.com
